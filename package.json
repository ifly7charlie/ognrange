{
    "name": "ognrange",
    "private": true,
    "scripts": {
        "dev": "NODE_OPTIONS='--inspect --enable-source-maps ' next dev",
        "build": "yarn bin:build && yarn next build",
        "bin:build": "tsc --project tsconfig-bin.json",
        "dumparrow": "node --enable-source-maps dist/bin/dumparrow.js",
        "purgeuptime": "node --enable-source-maps dist/bin/purgeuptime.js",
        "export": "next export",
        "start": "next start",
        "lint": "next lint",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@loaders.gl/arrow": "^4.3.4",
        "@loaders.gl/json": "^4.3.4",
        "apache-arrow": "^18.0.0",
        "deck.gl": "^9.2.11",
        "dotenv": "^16.0.0",
        "h3-js": "^4.1.0",
        "i18next": "^25.6.3",
        "lodash": "^4.17.23",
        "lru-cache": "^7.17.0",
        "mapbox-gl": "^3",
        "next": "15.5.12",
        "next-i18next": "15.4.3",
        "qrcode.react": "^4.2.0",
        "react": "^18.0.0",
        "react-bootstrap": "^2.1.2",
        "react-colorful": "^5.6.1",
        "react-dom": "^18.0.0",
        "react-i18next": "^16.3.5",
        "react-icons": "^4.3.1",
        "react-map-gl": "^8.1.0",
        "react-resizable-panels": "^4.7.1",
        "react-select": "^5.7.7",
