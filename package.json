{
    "name": "ognrange",
    "private": true,
    "scripts": {
        "dev": "NODE_OPTIONS='--inspect --enable-source-maps ' next dev",
        "build": "npm run bin:build && next build",
        "bin:build": "tsc --project tsconfig-bin.json",
        "dumparrow": "node --enable-source-maps dist/bin/dumparrow.js",
        "purgeuptime": "node --enable-source-maps dist/bin/purgeuptime.js",
        "export": "next export",
        "start": "next start",
        "lint": "next lint",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@deck.gl/core": "^9.4.0",
        "@deck.gl/geo-layers": "^9.4.0",
        "@deck.gl/layers": "^9.4.0",
        "@deck.gl/mapbox": "^9.4.0",
        "@loaders.gl/arrow": "^4.5.4",
        "@loaders.gl/json": "^4.5.4",
        "apache-arrow": "^18.0.0",
        "dotenv": "^16.0.0",
        "h3-js": "^4.1.0",
        "i18next": "^26.3.6",
        "lodash": "^4.18.1",
        "lru-cache": "^7.17.0",
        "mapbox-gl": "^3",
        "next": "^15.5.28",
        "next-i18next": "^16.0.10",
        "qrcode.react": "^4.2.0",
        "react": "^18.0.0",
        "react-bootstrap": "^2.1.2",
        "react-colorful": "^5.6.1",
        "react-dom": "^18.0.0",
        "react-i18next": "^17.0.11",
        "react-icons": "^4.3.1",
        "react-map-gl": "^8.1.0",
        "react-resizable-panels": "^4.7.1",
        "react-select": "^5.7.7",
        "react-visibility-sensor": "^5.1.1",
        "recharts": "^2.1.12",
        "swr": "^2.2.4",
        "yargs": "^17.3.1"
    },
    "devDependencies": {
        "@types/lodash": "^4.17.24",
        "@types/node": "^24.0.0",
        "@types/yargs": "^17.0.0",
        "@vitest/coverage-v8": "^4.0.18",
        "prettier": "^2.7.1",
        "ts-node": "^10.9.1",
        "typescript": "^5.1.0",
        "vitest": "^4.1.11"
    },
    "overrides": {
        "postcss": "^8.5.18"
    }
