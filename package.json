        "yargs": "^17.3.1"
    },
    "devDependencies": {
        "@types/lodash": "^4.17.24",
        "@types/node": "^18.11.9",
        "@types/yargs": "^17.0.0",
        "@vitest/coverage-v8": "^4.0.18",
        "prettier": "^2.7.1",
        "ts-node": "^10.9.1",
        "typescript": "^5.1.0",
        "vitest": "^4.0.18"
    },
    "resolutions": {
